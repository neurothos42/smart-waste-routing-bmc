SECRET_KEY=replace-with-a-secure-random-hex-key
FLASK_DEBUG=false
PORT=5000

# Demo Authentication Credentials
ADMIN_USER=admin
ADMIN_PASSWORD=adminpass
CITIZEN_USER=user123
CITIZEN_PASSWORD=userpass

# Simulation & Fleet Parameters
MAX_TRUCK_CAPACITY=5000
FUEL_MILEAGE_KMPL=3.5
FUEL_PRICE_INR=110.0
EXPORT_INTERVAL_CYCLES=60

# Storage & OSM Graph Caching
EXPORT_FOLDER=exports
OSM_GRAPH_PATH=osm_graph.graphml
DISABLE_OSM_DOWNLOAD=false